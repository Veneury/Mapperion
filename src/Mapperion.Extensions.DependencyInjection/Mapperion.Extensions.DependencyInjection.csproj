<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net472;net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Mapperion</RootNamespace>
    <AssemblyName>Mapperion.Extensions.DependencyInjection</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Mapperion.Extensions.DependencyInjection</PackageId>
    <Description>Registers Mapperion with Microsoft.Extensions.DependencyInjection.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="PolySharp" PrivateAssets="all" IncludeAssets="runtime;build;native;contentfiles;analyzers;buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Mapperion/Mapperion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    The public surface is written down in PublicAPI.Shipped.txt and checked against the code on
    every build, so adding, removing or changing anything public has to be done on purpose and
    shows up in the diff. Anything new goes into PublicAPI.Unshipped.txt and moves across when it
    is released.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
