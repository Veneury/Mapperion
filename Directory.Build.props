<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <NoWarn>$(NoWarn);NU1902</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Mapperion</Product>
    <VersionPrefix>0.10.0</VersionPrefix>
    <Authors>Mapperion contributors</Authors>
    <Copyright>Copyright (c) Mapperion contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>mapper;objectmapper;dto;mapping;automapper-alternative</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/Veneury/Mapperion</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Veneury/Mapperion</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    Strong naming, because a strong-named assembly on .NET Framework can only reference other
    strong-named assemblies: without this, a signed codebase on net472 cannot use Mapperion at all,
    and .NET Framework is a target this library goes out of its way to support.

    The key is in the repository on purpose. A strong name is an identity, not a security boundary:
    anyone can strip one and re-sign with a key of their own, so keeping the private half secret
    buys nothing and costs delay signing and verification skipping for everyone who builds. This is
    what the .NET projects themselves do.
  -->
  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)mapperion.snk</AssemblyOriginatorKeyFile>
    <!--
      The public half of the same key. A strong-named assembly may only open its internals to a
      friend it names together with a key, so every InternalsVisibleTo has to carry this. It is
      derived from the file beside it and changes only if that file does.
    -->
    <MapperionPublicKey></MapperionPublicKey>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup Condition="'$(CI)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
