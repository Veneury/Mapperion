{
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "Mapperion/Mapperion.csproj",
            "Mapperion.Extensions.DependencyInjection/Mapperion.Extensions.DependencyInjection.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0",
        "Configuration": "Release"
      },
      "memberLayout": "separatePages"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "obj/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "google6963982ff3bfb15c.html"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Mapperion",
      "_appTitle": "Mapperion",
      "_appFooter": "Mapperion \u2014 MIT licensed object mapper for .NET",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/Veneury/Mapperion",
        "branch": "main"
      }
    },
    "sitemap": {
      "baseUrl": "https://veneury.github.io/Mapperion/"
    }
  }
}
